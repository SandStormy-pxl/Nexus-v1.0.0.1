# Copie este arquivo para ".env" e preencha com seus valores reais
# NUNCA suba o .env pro GitHub!

# Gere uma chave forte, ex: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-secreta-gerada-por-voce

DEBUG=True

# Pegue essa URL no painel do Supabase (Connection Pooling, porta 6543)
DATABASE_URL=postgresql://usuario:senha@host-do-pooler.supabase.com:6543/postgres

# Domínios permitidos em produção, separados por vírgula (ex: meuapp.vercel.app)
ALLOWED_HOSTS=*
